	)
	(text_box "Potentiometer R_{V3} provides volume control. \n\nWhen R_{V3} is at position (1), we get the maximum volume because the signal is fed directly to the output buffer U6A\n\nWhen R_{V3} is at position (3), the output is muted because the output buffer U6A receives a constant 4.5V input."
		(exclude_from_sim no)
		(at 411.48 192.752 0)
		(size 36.83 16.6251)
