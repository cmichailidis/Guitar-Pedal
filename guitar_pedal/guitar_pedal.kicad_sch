			)
			(justify left top)
		)
		(uuid "3bc7e86a-ecf3-4440-aa27-22b061e6f781")
	)
	(text_box "The DC gain of the pre-amplifier is 16.4dB\nThe cutoff frequency is 284kHz"
		(exclude_from_sim no)
		(at 124.46 110.49 0)
		(size 40.64 5.08)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type dot)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.016 1.016)
				(thickness 0.127)
			)
			(justify left top)
		)
		(uuid "3c9b7956-192e-47d8-bf7f-c62117c15caf")
	)
	(text_box "When the output of the hysteresis-comparator is 'HIGH', Q3 pulls the output line to GND.\n\nOtherwise the output line is kept at high-impedance, because Q3 is in cutoff."
		(exclude_from_sim no)
		(at 363.22 82.0891 0)
		(size 27.94 13.3537)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type dot)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.016 1.016)
				(thickness 0.127)
			)
			(justify left top)
		)
		(uuid "5bd59e4d-1cb6-4b09-8ded-c1ad69bd1664")
	)
	(text_box "U4B and D4 work together as an ideal diode (ie near-zero threshold voltage)\nR29, RV4 and C27 form the Low Pass Filter of the envelope-detector.\nThe cutoff frequency can be adjusted through the RV4 potentiometer."
		(exclude_from_sim no)
		(at 176.53 50.8 0)
		(size 64.77 6.35)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type dot)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.016 1.016)
				(thickness 0.127)
			)
			(justify left top)
		)
		(uuid "93d5877a-20e7-40e7-b54c-7af3b62db0c7")
	)
	(text_box "R5: weak pulldown. Pulls the input to ground when no external signal is present.\nR4-C7: Passive, Low-Pass filter. Removes unwanted high-frequency noise.\nC8: Removes any unwanted DC offset from the input signal.\nR6: weak pullup. Injects a stable 4.5V DC offset to the signal\nU1B: Voltage buffer. Acts as a low-impedance voltage source for the next stages."
		(exclude_from_sim no)
		(at 36.83 148.59 0)
		(size 67.31 10.16)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type dot)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.016 1.016)
				(thickness 0.127)
			)
			(justify left top)
		)
		(uuid "9b0a57b1-137c-465e-811f-c0d9824ded38")
	)
	(text_box "When R_{V5} is turned to position (1):\n -> V_{ref} = 4.5V\nWhen R_{V5} is turned to position (3):\n -> V_{ref} = 4.93V"
		(exclude_from_sim no)
		(at 274.32 35.306 0)
		(size 30.48 8.89)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type dot)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.016 1.016)
				(thickness 0.127)
			)
			(justify left top)
		)
		(uuid "a01326c7-6bb8-46cf-bcab-6c53232a333a")
	)
	(text_box "When the output of the hysteresis-comparator is 'HIGH' (approximately 9V), D11 lights up and D12 turns off. \n\nWhen the output of the comparator is 'LOW' (approximately 0V), D11 turns off and D12 lights up.\n\nThe user can use those LEDs to get an idea of how 'sensitive' the comparator is and adjust its reference voltage through the RV5 potentiometer."
		(exclude_from_sim no)
		(at 403.86 33.02 0)
		(size 38.1 24.13)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type dot)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.016 1.016)
				(thickness 0.127)
			)
			(justify left top)
		)
		(uuid "b1503471-b33b-4789-86ec-686d88e40262")
	)
	(text_box "When the output of the hysteresis-comparator is 'HIGH', Q2 pulls the output line to 4.5V\n\nOtherwise the output line is kept at high-impedance, because Q2 is in cutoff."
		(exclude_from_sim no)
		(at 363.22 104.9491 0)
		(size 27.94 13.3537)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
