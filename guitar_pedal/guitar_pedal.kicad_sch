	(text ""
		(exclude_from_sim no)
		(at 417.322 199.39 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "e4fdf8d3-ca98-43a2-a93d-a888af7e3123")
	)
	(text_box "D9: Reverse-polarity-protection Schottky diode for 9V battery input.\nC1: Decoupling capacitor for 9V rail\nD10 - R43: Power Indicator LED with current limiting resistor\nR1 - R2: Resistor network for generating the reference voltage of the 4.5V rail\nU1A: Voltage buffer which acts as a low-impedance 4.5V voltage source.\nC4 - C5: Decoupling capacitors for the 4.5V rail"
		(exclude_from_sim no)
		(at 248.92 228.6 0)
		(size 64.77 11.43)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type dot)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.016 1.016)
				(thickness 0.127)
			)
			(justify left top)
		)
		(uuid "19c52c15-8f5d-445f-8de4-1fd25e54f436")
	)
	(text_box "Potentiometer R_{V2} provides tone control\n\nWhen R_{V2} is at position (1), low frequencies are favored over high frequencies\n\nWhen R_{V3} is at position (3), high frequencies are favored over low frequencies"
		(exclude_from_sim no)
		(at 364.49 195.4649 0)
		(size 34.29 16.6251)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type dot)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.016 1.016)
				(thickness 0.127)
			)
			(justify left top)
		)
		(uuid "22b7185d-f36c-4e63-bf6c-941d422be02b")
	)
	(text_box "When V_{in} > V_{ref}:\n V_{out} = 0V (LOW)\n\nWhen V_{in} < V_{ref}:\n V_{out} = 9V (HIGH)\n"
		(exclude_from_sim no)
		(at 279.4 80.01 0)
		(size 17.78 10.16)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type dot)
		)
		(fill
			(type none)
