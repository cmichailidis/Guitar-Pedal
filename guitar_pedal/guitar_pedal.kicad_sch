			)
			(justify left top)
		)
		(uuid "c289dbe8-28af-40d5-998d-10756159e81b")
	)
	(text_box "R30 and C28 form an additional Low-Pass Filter with a cutoff frequency of 72Hz."
		(exclude_from_sim no)
		(at 177.8 96.52 0)
		(size 36.83 5.1752)
		(margins 0.9525 0.9525 0.9525 0.9525)
