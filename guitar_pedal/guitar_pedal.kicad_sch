	)
	(text_box "When Q2 and Q3 are in the cutoff region, the output buffer (U5B) is driven by the distortion-clipping pedal.\n\nWhen Q2 and Q3 are saturated, the output stage is pulled 'LOW' and the guitar pedal is muted."
		(exclude_from_sim no)
		(at 482.6 144.78 0)
		(size 35.56 13.3537)
		(margins 0.9525 0.9525 0.9525 0.9525)
