		(uuid "e917ae73-0a07-48de-8699-f76d0da37c53")
	)
	(text_box "When R_{V4} is at position (1), f_{c} = 0.31Hz\n\nWhen R_{V4} is at position (3), f_{c} = 3.39Hz"
		(exclude_from_sim no)
		(at 177.8 87.63 0)
